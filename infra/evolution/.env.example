# Copie para `.env` e rode ./gerar-chave.sh para preencher os dois segredos.

# O endereço PÚBLICO por onde o CRM alcança este servidor.
#
# Precisa ser HTTPS: as edge functions do Supabase rodam na nuvem e não chamam
# HTTP nem localhost. É também o endereço que você cola no CRM, em
# Integrações → WhatsApp por QR code.
SERVER_URL=https://evolution.suaempresa.com.br

# A chave que autentica TODA chamada à API. É esta que você cola no CRM.
# Gerada por ./gerar-chave.sh — não invente uma curta.
AUTHENTICATION_API_KEY=

# Senha do Postgres interno. Também gerada pelo script.
POSTGRES_PASSWORD=
